# Copy to ".env" for local development.
# NOTE: Current code reads from process.env; loading ".env" (dotenv) can be wired up later.

# --- Gemini 3 (Phase 1: Topic Research Engine) ---
GEMINI_API_KEY=your_api_key_here
# Optional override:
# - For local testing (lower quota requirements): gemini-2.0-flash
# - For your intended architecture (Gemini 3): gemini-3-pro-preview
GEMINI_MODEL=gemini-3-flash

# --- Nano Banana (Phase 2: Storyboard Engine) ---
# Nano Banana is Gemini's native image generation model series.
# Phase 2 calls Gemini directly using GEMINI_API_KEY; no separate endpoint is required.
#
# Optional override for the image model (recommended default shown):
NANOBANANA_MODEL=gemini-3-flash-image
DEEPGRAM_API_KEY=
TTS_PROVIDER=deepgram

